# Jira credentials for optional validation/enrichment (NOT needed just to link tickets).
# Copy to a git-ignored location (e.g. ~/.config/bt-deploy/jira.env), fill in, then `source` it.
# NEVER commit the filled file. Rotate the token if it leaks.
export JIRA_BASE_URL="https://<your-site>.atlassian.net"
export JIRA_EMAIL="<your-atlassian-account-email>"
export JIRA_API_TOKEN="paste-a-fresh-token-here"
